# ==========================================
# BRIDGE FLOW: GLOBAL SHOPIFY APP CREDENTIALS
# ==========================================
SHOPIFY_CLIENT_ID=your_client_id
SHOPIFY_CLIENT_SECRET=your_client_secret
SHOPIFY_REDIRECT_URI=http://localhost:8000/auth/shopify/callback
SHOPIFY_API_VERSION=2026-07
SHOPIFY_SCOPES=read_products,read_orders,read_customers,read_inventory,read_locations

# ==========================================
# SECURITY ENCRYPTION KEY (FERNET AES-128-CBC + HMAC-SHA256)
# Generate via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ==========================================
STORE_TOKEN_ENCRYPTION_KEY=your_generated_fernet_key_here

# ==========================================
# META ADS API CONFIGURATION
# ==========================================
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_REDIRECT_URI=http://localhost:8000/integrations/meta/callback
META_API_VERSION=v25.0

# ==========================================
# DEFAULT BUSINESS IDENTIFIER
# ==========================================
BUSINESS_ID=1

# ==========================================
# POSTGRESQL 18 DATABASE CONFIGURATION
# ==========================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecommerce_intelligence
DB_USER=postgres
DB_PASSWORD=your_db_password_here
